	select*
    from pizza_sales
    ;
    select round(sum(total_price),2) AS Total_Revenue
    from pizza_sales
    ;
	select round(sum(total_price)/count(distinct order_id),2) as Average_Order_Value
    from pizza_sales
    ;
    select sum(quantity)
    from pizza_sales
    ;
    select count(distinct order_id)
    from pizza_sales
    ;
    select sum(quantity) / count(distinct order_id) as Avg_pizza_per_order
    from pizza_sales
    ;
    select DAYNAME(order_date)
    from pizza_sales
    ;
    UPDATE pizza_sales
SET order_date = STR_TO_DATE(order_date, '%d-%m-%Y');

select dayname(order_date) as Day_of_order, count(distinct order_id) as Count_of_orders

from pizza_sales
group by Day_of_order
;
select monthname(order_date) as month, count(distinct order_id) as Count_of_orders
from pizza_sales
group by month 
order by Count_of_orders desc
;

select pizza_category, round(sum(total_price)*100/ (select sum(total_price)
from pizza_sales
),2) as percentage_of_sales
from pizza_sales
group by pizza_category

;
select sum(total_price)
from pizza_sales
;
select pizza_size, round(sum(total_price)*100/ (select sum(total_price)
from pizza_sales
),2) as percentage_of_sales
from pizza_sales
group by pizza_size
order by percentage_of_sales desc

;
#Total pizza sold by pizza category
select pizza_category, sum(quantity) as qty_sold
from pizza_sales
group by pizza_category
;

#Top 5 bestsellers by total qty, revenue, order 
select pizza_name, sum(total_price) as total_price_sold
from pizza_sales
group by pizza_name 
order by sum(total_price) desc
limit 5
;

select pizza_name, sum(quantity) as total_qty_sold
from pizza_sales
group by pizza_name 
order by total_qty_sold desc
limit 5
;

select pizza_name, count(distinct order_id) as total_order
from pizza_sales
group by pizza_name 
order by total_order desc
limit 5

