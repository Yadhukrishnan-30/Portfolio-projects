WITH RECURSIVE ingredient_split AS (
  SELECT 
    pizza_id,
    pizza_name,
    TRIM(SUBSTRING_INDEX(pizza_ingredients, ',', 1)) AS ingredient,
    SUBSTRING(pizza_ingredients, LOCATE(',', pizza_ingredients) + 1) AS rest
  FROM pizza_sales

  UNION ALL

  SELECT 
    pizza_id,
    pizza_name,
    TRIM(SUBSTRING_INDEX(rest, ',', 1)),
    SUBSTRING(rest, LOCATE(',', rest) + 1)
  FROM ingredient_split
  WHERE rest LIKE '%,%'
  
  UNION ALL

  SELECT 
    pizza_id,
    pizza_name,
    TRIM(rest),
    NULL
  FROM ingredient_split
  WHERE rest NOT LIKE '%,%'
)
SELECT 
  ingredient,
  COUNT(DISTINCT pizza_name) AS pizzas_with_ingredient
FROM ingredient_split
WHERE ingredient IS NOT NULL AND ingredient != ''
GROUP BY ingredient
ORDER BY pizzas_with_ingredient DESC
LIMIT 1;





